#!/usr/bin/env python3
"""Remove detached tmux sessions when all panes are idle shells or dead."""
import argparse
from dataclasses import dataclass
import os
from pathlib import Path
import subprocess
import sys

from lib import CommandError, capture, cli, require_command


def styled(text, code, *, file=None):
    stream = sys.stdout if file is None else file
    if stream.isatty() and 'NO_COLOR' not in os.environ and os.environ.get('TERM') != 'dumb':
        return f'\033[{code}m{text}\033[0m'
    return text


def show_candidates(candidates):
    count = len(candidates)
    noun = 'session' if count == 1 else 'sessions'
    print(f'\n  {count} detached {noun} ready to remove\n')
    width = max(len('SESSION'), *(len(name) for _, name, _ in candidates))
    print(styled(f'  {"SESSION":<{width}}  PANES', '2'))
    for _, name, reason in candidates:
        color = '36' if 'idle' in reason else '2'
        print(f'  {name:<{width}}  {styled(reason, color)}')


@dataclass(frozen=True)
class Process:
    parent: int
    state: str
    command: str


def process_snapshot():
    processes = {}
    for line in capture(['ps', '-axo', 'pid=,ppid=,stat=,comm=']).splitlines():
        fields = line.split(None, 3)
        if len(fields) != 4:
            raise CommandError('Incomplete process snapshot; refusing to classify sessions')
        pid, parent, state, command = fields
        processes[int(pid)] = Process(int(parent), state, command)
    return processes


def shell_names():
    # Discover shells from the host, rather than maintain a list of applications.
    names = set()
    for line in Path('/etc/shells').read_text().splitlines():
        line = line.strip()
        if line.startswith('/'):
            names.add(Path(line).name)
    if os.environ.get('SHELL'):
        names.add(Path(os.environ['SHELL']).name)
    return names


def pane_idle(pid, command, processes, shells):
    root = processes.get(pid)
    if root is None or root.state.startswith(('Z', 'T')):
        return False
    if Path(root.command).name.lstrip('-') not in shells or command not in shells:
        return False
    # Every live descendant protects the pane, including background jobs and
    # programs whose foreground title happens to resemble a shell.
    children = {}
    for child, process in processes.items():
        children.setdefault(process.parent, []).append(child)
    pending = list(children.get(pid, []))
    seen = {pid}
    while pending:
        child = pending.pop()
        if child in seen:
            return False
        seen.add(child)
        if not processes[child].state.startswith('Z'):
            return False
        pending.extend(children.get(child, []))
    return True


def session_idle(session_id, processes, shells):
    metadata = capture(['tmux', 'display-message', '-p', '-t', session_id,
                        '#{session_attached}\t#{@keep}']).rstrip('\n').split('\t')
    if len(metadata) != 2 or metadata[0] != '0' or metadata[1] not in ('', '0', 'off', 'false'):
        return False, 'attached or marked @keep'
    # -s is essential: without it tmux lists only the current window.
    panes = capture(['tmux', 'list-panes', '-s', '-t', session_id,
                     '-F', '#{pane_pid}\t#{pane_current_command}\t#{pane_dead}']).splitlines()
    if not panes:
        return False, 'no inspectable panes'
    dead = 0
    for pane in panes:
        fields = pane.split('\t')
        if len(fields) != 3 or fields[2] not in ('0', '1'):
            return False, 'unknown pane'
        # A confirmed dead pane has no running process; its old PID may be
        # absent from the snapshot or already reused by another process.
        if fields[2] == '1':
            dead += 1
            continue
        if not fields[0].isdigit():
            return False, 'unknown pane'
        if not pane_idle(int(fields[0]), fields[1], processes, shells):
            return False, f'active or uninspectable pane ({fields[1]})'
    counts = []
    if len(panes) > dead:
        counts.append(f'{len(panes) - dead} idle')
    if dead:
        counts.append(f'{dead} exited')
    return True, ', '.join(counts)


def main():
    parser = argparse.ArgumentParser(description=__doc__, epilog=
        'Any live child process protects a session (editors, agents, background jobs, etc.). '
        'Attached sessions and @keep sessions are always retained. '
        'Protect a session explicitly: tmux set-option -t SESSION @keep 1. '
        'Exit: 0 completed/cancelled, 1 inspection or deletion error, 2 invalid arguments.')
    parser.add_argument('--dry-run', action='store_true', help='list candidates without deleting or prompting')
    parser.add_argument('-v', '--verbose', action='store_true', help='show each deletion and explain retained sessions')
    parser.add_argument('-f', '--force', action='store_true', help='skip confirmation; protection and recheck still apply')
    args = parser.parse_args()
    require_command('tmux')
    require_command('ps')
    print(styled('\nTmux · cleanup', '1'))
    print(styled('─' * 40, '2'))
    # No server is an ordinary no-op; other tmux errors remain errors.
    result = subprocess.run(['tmux', 'list-sessions', '-F', '#{session_id}\t#{session_name}'],
                            text=True, stdout=subprocess.PIPE, stderr=subprocess.PIPE)
    if result.returncode:
        if 'no server running' in result.stderr or 'No such file or directory' in result.stderr:
            print('  No tmux sessions.'); return 0
        raise CommandError(result.stderr.strip())
    processes, shells = process_snapshot(), shell_names()
    candidates = []
    for line in result.stdout.splitlines():
        session_id, name = line.split('\t', 1)
        idle, reason = session_idle(session_id, processes, shells)
        if idle:
            candidates.append((session_id, name, reason))
        elif args.verbose:
            print(styled(f'  · Kept {name} · {reason}', '2'))
    if not candidates:
        print('  No idle detached sessions.'); return 0
    show_candidates(candidates)
    if args.dry_run:
        print('\n  Preview only; nothing deleted.'); return 0
    if not args.force:
        if not sys.stdin.isatty():
            raise CommandError('Confirmation requires a terminal; use --dry-run or --force')
        noun = 'session' if len(candidates) == 1 else 'sessions'
        if input(styled(f'\n  Delete {len(candidates)} {noun}? [y/N] ', '33')).strip().lower() not in ('y', 'yes'):
            print('  Cancelled.'); return 0
    if args.verbose:
        print()
    deleted = kept = errors = 0
    for session_id, name, _ in candidates:
        try:
            # Recheck attachment, all panes and processes after confirmation.
            idle, reason = session_idle(session_id, process_snapshot(), shells)
            if not idle:
                print(styled(f'  ! Kept {name} · {reason}', '33'))
                kept += 1
                continue
            capture(['tmux', 'kill-session', '-t', session_id])
            deleted += 1
            if args.verbose:
                print(styled(f'  ✓ Deleted {name}', '32'))
        except CommandError as error:
            print(styled(f'  ✗ {name} · {error}', '31', file=sys.stderr), file=sys.stderr)
            errors += 1
    noun = 'session' if deleted == 1 else 'sessions'
    summary = [f'Deleted {deleted} {noun}']
    if kept:
        summary.append(f'{kept} kept')
    if errors:
        summary.append(f'{errors} failed')
    print(styled('\n  ' + ('✗ ' if errors else '✓ ') + ' · '.join(summary), '31' if errors else '32'))
    return int(bool(errors))


if __name__ == '__main__':
    sys.exit(cli(main))
