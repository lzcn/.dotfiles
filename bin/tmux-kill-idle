#!/usr/bin/env bash
# tmux-kill-idle — find and kill idle tmux sessions
#
# An "idle" session has no pane running a foreground process —
# only interactive shells (bash, zsh, fish, etc.) sitting at a prompt.
# Any editor, compiler, interpreter, or long-running command makes a
# session "active". Sessions are listed and confirmed before killing.

set -euo pipefail

# Processes that count as "nothing running"
IDLE_COMMS='^(bash|zsh|fish|sh|dash|tmux|tmux:.*)$'

SCRIPT_NAME="${0##*/}"

usage() {
  cat <<'EOF'
Usage: tmux-kill-idle [-v] [-f]

Find idle tmux sessions (no active foreground process) and kill them
after confirmation.

Options:
  -v, --verbose   Show pane-level details for each idle session
  -f, --force     Skip confirmation (kill immediately)
  -h, --help      Show this help

An "idle" session is one where every pane is just a shell at a prompt
— no editors, compilers, interpreters, or other active programs.

EOF
  exit 0
}

die() {
  echo "$SCRIPT_NAME: $*" >&2
  exit 1
}

# Recursively check if a process tree is idle (only contains idle shells).
# Returns 0 if idle, 1 if any non-idle process is found.
proc_tree_idle() {
  local pid=$1
  [[ -d "/proc/$pid" ]] || return 0

  # Skip zombies — they're dead and won't do work
  local state
  state=$(awk '/^State:/ {print $2}' /proc/"$pid"/status 2>/dev/null)
  [[ "$state" == "Z" ]] && return 0

  local comm
  comm=$(cat /proc/"$pid"/comm 2>/dev/null) || return 0

  # If this process itself is non-idle, the tree is active
  if ! echo "$comm" | grep -qE "$IDLE_COMMS"; then
    return 1
  fi

  # Recurse into children
  local children
  children=$(cat /proc/"$pid"/task/"$pid"/children 2>/dev/null)
  for cpid in $children; do
    if ! proc_tree_idle "$cpid"; then
      return 1
    fi
  done
  return 0
}

# Check a single pane (by its shell PID) for activity
pane_is_idle() {
  local pane_pid=$1
  proc_tree_idle "$pane_pid"
}

main() {
  [[ "$(uname)" == "Linux" ]] || die "this script requires /proc (Linux only)"

  local verbose=false
  local force=false

  while [[ $# -gt 0 ]]; do
    case "$1" in
      -v|--verbose) verbose=true; shift ;;
      -f|--force)   force=true;   shift ;;
      -h|--help)    usage ;;
      -*) die "unknown option: $1" ;;
      *) die "unexpected argument: $1" ;;
    esac
  done

  tmux has-session 2>/dev/null || die "no tmux server running"

  # Detect current session (if running inside tmux) to note it
  local current_session=""
  [[ -n "${TMUX:-}" ]] && current_session=$(tmux display-message -p '#S' 2>/dev/null) || true

  local -a idle_sessions=()

  while IFS= read -r session; do
    [[ -n "$session" ]] || continue

    local has_active=false

    while IFS= read -r pane_pid; do
      [[ -n "$pane_pid" ]] || continue
      if ! pane_is_idle "$pane_pid"; then
        has_active=true
        break
      fi
    done < <(tmux list-panes -t "$session" -F '#{pane_pid}' 2>/dev/null)

    if ! $has_active; then
      idle_sessions+=("$session")
    fi
  done < <(tmux list-sessions -F '#{session_name}' 2>/dev/null)

  if [[ ${#idle_sessions[@]} -eq 0 ]]; then
    echo "No idle tmux sessions found."
    exit 0
  fi

  # Print idle sessions
  echo "=== Idle tmux sessions ==="
  local idx=1
  for session in "${idle_sessions[@]}"; do
    local nw
    nw=$(tmux list-windows -t "$session" -F 'x' 2>/dev/null | wc -l)
    local np
    np=$(tmux list-panes -t "$session" -F 'x' 2>/dev/null | wc -l)

    echo "[$idx] $session  (${nw}w, ${np}p)"

    if $verbose; then
      # Show each pane's info
      local pane_idx=1
      while IFS= read -r line; do
        local pane_cmd pane_cwd
        pane_cmd=$(echo "$line" | cut -f1)
        pane_cwd=$(echo "$line" | cut -f2)
        printf '    pane %s: %-20s  %s\n' "$pane_idx" "$pane_cmd" "$pane_cwd"
        ((pane_idx++))
      done < <(tmux list-panes -t "$session" \
        -F '#{pane_current_command} #{pane_current_path}' 2>/dev/null)
    fi

    if [[ -n "$current_session" ]] && [[ "$session" == "$current_session" ]]; then
      echo "    (this is your current session)"
    fi
    ((idx++))
  done
  echo

  # Confirmation
  if $force; then
    for session in "${idle_sessions[@]}"; do
      echo "Killing: $session"
      tmux kill-session -t "$session"
    done
    echo "Killed ${#idle_sessions[@]} session(s)."
    exit 0
  fi

  printf "Kill these %d session(s)? [y/N] " "${#idle_sessions[@]}"
  read -r answer
  case "${answer:-}" in
    [Yy]|[Yy][Ee][Ss])
      for session in "${idle_sessions[@]}"; do
        echo "Killing: $session"
        tmux kill-session -t "$session"
      done
      echo "Done — killed ${#idle_sessions[@]} session(s)."
      ;;
    *)
      echo "Aborted."
      ;;
  esac
}

main "$@"
