#!/usr/bin/env zsh
# intruder-detect — report failed login attempts from auth.log

source "${0:A:h}/lib.sh"

authlog=${1:-/var/log/auth.log}
[[ -r "$authlog" ]] || die "log not readable: $authlog"
info "analyzing $authlog"

tmpfile=$(mktemp)
trap 'rm -f "$tmpfile"' EXIT

grep "Failed pass" "$authlog" >"$tmpfile"

users=$(awk '{ print $(NF-5) }' "$tmpfile" | sort -u)
ip_list=$(grep -Eo '[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+' "$tmpfile" | sort -u)

printf "%-10s|%-3s|%-16s|%-33s|%s\n" "User" "Attempts" "IP address" "Host" "Time range"

for ip in $ip_list; do
    for user in $users; do
        attempts=$(grep -F "$ip" "$tmpfile" | grep -c " $user ")
        (( attempts == 0 )) && continue
        first_time=$(grep -F "$ip" "$tmpfile" | grep " $user " | head -1 | cut -c-16)
        time="$first_time"
        if (( attempts > 1 )); then
            last_time=$(grep -F "$ip" "$tmpfile" | grep " $user " | tail -1 | cut -c-16)
            time="$first_time -> $last_time"
        fi
        HOST=$(host "$ip" 8.8.8.8 | tail -1 | awk '{ print $NF }')
        printf "%-10s|%-3s|%-16s|%-33s|%-s\n" "$user" "$attempts" "$ip" "$HOST" "$time"
    done
done
