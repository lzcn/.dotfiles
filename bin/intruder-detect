#!/usr/bin/env python3
"""Summarize failed SSH password logins; failures alone do not prove intrusion."""
import argparse
from dataclasses import dataclass
import ipaddress
import re
import sys

from lib import cli, readable_file

FAILED = re.compile(r'\bFailed password for (?:invalid user )?(\S+) from (\S+) port \d+')
TIMESTAMP = re.compile(r'^(?:\w{3}\s+\d{1,2}\s+\d{2}:\d{2}:\d{2}|\d{4}-\d{2}-\d{2}T\S+)')


@dataclass
class Attempts:
    count: int = 0
    first: str = ''
    last: str = ''


def summarize(lines):
    records = {}
    for line in lines:
        match = FAILED.search(line)
        if not match:
            continue
        user, address = match.groups()
        try:
            address = str(ipaddress.ip_address(address))
        except ValueError:
            continue
        timestamp = TIMESTAMP.match(line)
        time = timestamp.group() if timestamp else 'unknown'
        record = records.setdefault((user, address), Attempts())
        record.count += 1
        if record.count == 1:
            record.first = time
        record.last = time
    return records


def main():
    parser = argparse.ArgumentParser(description=__doc__, epilog=
        'Supports IPv4/IPv6 and valid/invalid usernames. Reads this file only; '
        'no reverse DNS requests. Time range follows log order. '
        'Exit: 0 report complete, 1 read error, 2 invalid arguments.')
    parser.add_argument('log', nargs='?', default='/var/log/auth.log', help='auth log (default: /var/log/auth.log)')
    args = parser.parse_args()
    with readable_file(args.log).open(errors='replace') as log:
        records = summarize(log)
    if not records:
        print('No failed SSH password logins.'); return 0
    print(f"{'User':<20} {'Attempts':>8} {'IP address':<39} Time range")
    for (user, address), record in sorted(records.items(), key=lambda item: (-item[1].count, item[0])):
        time = record.first if record.count == 1 else f'{record.first} -> {record.last}'
        print(f'{user:<20} {record.count:>8} {address:<39} {time}')


if __name__ == '__main__':
    sys.exit(cli(main))
