#!/usr/bin/env zsh

source "${0:A:h}/lib.sh"

update_brew=1 update_zinit=1 update_git=1 update_nvim=1
update_snippets=0
dotfiles="${0:A:h:h}"
zinit_home="${XDG_DATA_HOME:-$HOME/.local/share}/zinit/zinit.git"

usage() {
    cat <<'HELP'
Usage: dots-update [OPTIONS]
  (default)    Update Homebrew packages/apps, Zinit, Git repos, and Neovim
  --all        Update all components (default)
  --snippets   Also refresh snippets declared in .zshrc
  --light      Update Git repos only
  --nvim       Include Neovim plugins
  --no-brew --no-zinit --no-git --no-nvim   Skip a component
  --proxy      Use PROXY_HOST/PROXY_HTTP_PORT/PROXY_SOCKS_PORT
  --no-proxy   Clear proxy variables; otherwise inherit the current proxy
  --help, -h   Show help

Snippets are skipped by default, including with --all.
Configuration and Swift compilation are handled separately by make setup.
HELP
}

for arg in "$@"; do
    case "$arg" in
        --all) update_brew=1 update_zinit=1 update_git=1 update_nvim=1 ;;
        --light) update_brew=0 update_zinit=0 update_git=1 update_nvim=0 ;;
        --nvim) update_nvim=1 ;;
        --snippets) update_snippets=1 ;;
        --no-brew) update_brew=0 ;;
        --no-zinit) update_zinit=0 ;;
        --no-git) update_git=0 ;;
        --no-nvim) update_nvim=0 ;;
        --proxy)
            export http_proxy="http://${PROXY_HOST:-127.0.0.1}:${PROXY_HTTP_PORT:-7890}"
            export https_proxy=$http_proxy
            export all_proxy="socks5://${PROXY_HOST:-127.0.0.1}:${PROXY_SOCKS_PORT:-${PROXY_HTTP_PORT:-7890}}"
            ;;
        --no-proxy) unset http_proxy https_proxy all_proxy HTTP_PROXY HTTPS_PROXY ALL_PROXY ;;
        --help|-h) usage; exit 0 ;;
        *) print -u2 -r -- "Unknown option: $arg"; usage; exit 1 ;;
    esac
done

# Report failures but continue updating independent components.
run_update() {
    local label=$1
    shift
    local started=$SECONDS
    section "$label"
    if "$@"; then
        ok "$label · $(( SECONDS - started ))s"
        (( successes += 1 ))
    else
        fail "$label update failed"
        failed_components+=("$label")
        (( failures += 1 ))
    fi
}

update_homebrew() {
    brew update && brew upgrade --greedy --yes && brew cleanup && brew autoremove
}

update_zinit_plugins() {
    source "$zinit_home/zinit.zsh" || return
    zinit self-update && zinit update --plugins || return
    if (( update_snippets )); then
        # Read literal snippet declarations without loading the interactive shell.
        local line
        local -a words
        while IFS= read -r line; do
            words=(${(z)line})
            [[ ${words[1]:-} == zinit && ${words[2]:-} == snippet ]] || continue
            zinit update "${words[3]}" || return
        done < "$dotfiles/zsh/.zshrc"
    else
        info "Snippets skipped; use --snippets to refresh active snippets"
    fi
}

update_repo() {
    git -C "$1" pull --ff-only && git -C "$1" submodule update --init --recursive
}

banner "Dotfiles · update"
failures=0 successes=0
failed_components=()

if (( update_git )); then
    for repo in "$dotfiles" "$HOME/.tmux" "$HOME/.gitalias" "$HOME/Library/Rime"; do
        [[ -e "$repo/.git" ]] || continue
        run_update "Git: ${repo:t}" update_repo "$repo"
    done
fi

if (( update_brew )); then
    if (( $+commands[brew] )); then
        run_update Homebrew update_homebrew
    else
        warn "brew not found, skipping"
    fi
fi

if (( update_zinit )); then
    if [[ -r "$zinit_home/zinit.zsh" ]]; then
        run_update Zinit update_zinit_plugins
    else
        warn "Zinit not found, skipping"
    fi
fi

if (( update_nvim )); then
    if (( $+commands[nvim] )); then
        run_update Neovim nvim --headless '+Lazy! sync' +qa
    else
        warn "nvim not found, skipping"
    fi
fi

if (( failures )); then
    fail "$successes succeeded; $failures failed: ${(j:, :)failed_components}"
    exit 1
fi
finish "$successes updates complete"
