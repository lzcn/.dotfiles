#!/usr/bin/env bash
# Filename: active_users.sh
# Description: Reporting tool to find out active users

set -euo pipefail

log=/var/log/wtmp
if [[ -n "${1:-}" ]]; then
  log=$1
fi

tmpdir=$(mktemp -d)
trap 'rm -rf "$tmpdir"' EXIT
ulog="$tmpdir/ulog"
users_file="$tmpdir/users"
user_file="$tmpdir/user"

printf "%-4s %-10s %-12s %-6s %-8s\n" "Rank" "User" "Start" "Logins" "Hours"

last -f "$log" | head -n -2 >"$ulog"
cut -d' ' -f1 "$ulog" | sort | uniq >"$users_file"

(
  while IFS= read -r user; do
    grep "^$user" "$ulog" >"$user_file"

    minutes=0
    while IFS= read -r t; do
      s=$(echo "$t" | awk -F: '{ print ($1 * 60) + $2 }')
      (( minutes += s ))
    done < <(awk '{ print $NF }' "$user_file" | tr -d ')(')

    firstlog=$(tail -n 1 "$user_file" | awk '{ print $5, $6 }')
    nlogins=$(wc -l <"$user_file")
    hours=$(echo "$minutes / 60.0" | bc)
    printf "%-10s %-12s %-6s %-8s\n" "$user" "$firstlog" "$nlogins" "$hours"
  done <"$users_file"
) | sort -nrk 4 | awk '{ printf("%-4s %s\n", NR, $0) }'
